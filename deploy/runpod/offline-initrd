#!/bin/sh
set -eu
b=/bin/busybox
$b mount -t devtmpfs devtmpfs /dev
while IFS= read -r module; do
    $b insmod "/modules/$module"
done < /modules/order
for attempt in 1 2 3 4 5; do
    [ -b /dev/vda ] && break
    $b sleep 1
done
$b mount -t squashfs -o ro /dev/vda /rootfs
$b mount --move /dev /rootfs/dev
$b mount -t proc proc /rootfs/proc
$b mount -t sysfs sysfs /rootfs/sys
$b mount -t tmpfs -o mode=1777,size=512m tmpfs /rootfs/tmp
$b mkdir -p /rootfs/dev/shm /rootfs/tmp/render-home
$b mount -t tmpfs -o mode=1777,size=256m tmpfs /rootfs/dev/shm
$b chown 10001:10001 /rootfs/tmp/render-home
$b mount -t 9p -o trans=virtio,version=9p2000.L,msize=262144 job /rootfs/job
$b ip link set lo up
test "$($b ls /rootfs/sys/class/net)" = lo
test -z "$($b ip route show default)"
exec $b switch_root /rootfs /opt/editorgpt-guest-init
