[Unit]
Description=EditorGPT RunPod measured billing reconciliation
After=network-online.target

[Service]
Type=oneshot
User=editorgpt
WorkingDirectory=/opt/editorgpt
EnvironmentFile=/etc/editorgpt/render-reaper.env
ExecStart=/opt/editorgpt/.venv/bin/python -m app.render_cloud.reaper --billing
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/editorgpt/cloud-render /var/lib/editorgpt/jobs
UMask=0077
